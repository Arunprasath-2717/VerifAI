# ==============================================================================
# VerifAI Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Metadata
APP_NAME=VerifAI API
APP_VERSION=0.1.0

# Environment: "development", "testing", or "production"
ENVIRONMENT=development

# Debug Mode: true for development, MUST be false in production
DEBUG=true

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS Allowed Origins: comma-separated list of origins (no spaces or clean list)
# Example for development with frontend on port 3000/5173:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL / Supabase)
# For local development or Supabase PostgreSQL connection:
# postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verifai

# Database Pool Settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_TIMEOUT=5.0

# Supabase Auth Configuration
# Obtain from your Supabase project dashboard: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key is only used on backend for administrative cleanup/deletion (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Verification Engine Configuration (Phase 2D)
# ==============================================================================
# LLM provider: obtain a Gemini API key from https://aistudio.google.com/
# When absent or left empty, the engine degrades gracefully:
#   - extraction returns the raw claim as a single claim
#   - classification returns GENERAL
#   - judge returns ABSENT for all sources
#   - final verdict will be UNKNOWN
GEMINI_API_KEY=your-gemini-api-key

# LLM model name (gemini-1.5-flash is free-tier; gemini-1.5-pro for higher quality)
LLM_MODEL=gemini-1.5-flash

# Max web sources fetched per claim (cost control)
ENGINE_MAX_SOURCES_PER_CLAIM=5
