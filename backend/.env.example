# VerifAI Backend Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS TO SOURCE CONTROL

# ==============================================================================
# Application & Runtime Settings (Optional - Defaults provided)
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="VerifAI"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# ==============================================================================
# Future Integration Settings (Unconfigured during Phase 1 Bootstrap)
# Required in later phases:
# ==============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/verifai
