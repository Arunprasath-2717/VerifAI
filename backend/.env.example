# VerifAI Backend Environment Configuration Example
# Copy to .env for local development: cp backend/.env.example backend/.env
# DO NOT COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS TO SOURCE CONTROL

# ==============================================================================
# Application Metadata & Runtime
# ==============================================================================
PROJECT_NAME="VerifAI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT=development    # Options: development, test, staging, production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Logging & Request Correlation
# ==============================================================================
LOG_LEVEL=INFO             # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
REQUEST_ID_HEADER="X-Request-ID"

# ==============================================================================
# CORS Configuration
# ==============================================================================
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# ==============================================================================
# Database Configuration (PostgreSQL + asyncpg via Supabase)
# When unconfigured, readiness probe returns 503 and app runs ephemerally.
#
# Get your connection string from:
#   Supabase Dashboard → Project Settings → Database → Connection String
#   (use the "Transaction Pooler" URI for asyncpg compatibility)
# ==============================================================================
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=3.0

# ==============================================================================
# Supabase Project Credentials
# Obtain from: Supabase Dashboard → Project Settings → API
# ==============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# ==============================================================================
# Verification Engine Configuration
# ==============================================================================
VERIFICATION_MAX_INPUT_CHARS=20000
VERIFICATION_MAX_CLAIMS=20
RETRIEVAL_TIMEOUT_SECONDS=8.0
ENABLE_LIVE_SEARCH=false   # Set true to activate Tavily → DDG → Nightcrawler chain

# ==============================================================================
# Tavily Web Search (primary live evidence retrieval)
# Obtain API key from: https://tavily.com
# When absent, the system falls through to DuckDuckGo automatically.
# ==============================================================================
# TAVILY_API_KEY=tvly-...
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic    # Options: basic, advanced
# TAVILY_TIMEOUT_SECONDS=8.0

# ==============================================================================
# DuckDuckGo Search (secondary fallback — no API key required)
# ==============================================================================
ENABLE_DUCKDUCKGO_FALLBACK=true
# DUCKDUCKGO_MAX_RESULTS=5
# DUCKDUCKGO_TIMEOUT_SECONDS=6.0

# ==============================================================================
# Nightcrawler / Wikipedia REST API (tertiary safe fallback)
# Uses Wikipedia public REST API — no authentication required.
# ==============================================================================
ENABLE_NIGHTCRAWLER_FALLBACK=true
# NIGHTCRAWLER_TIMEOUT_SECONDS=5.0
