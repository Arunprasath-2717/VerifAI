# VerifAI Backend Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS TO SOURCE CONTROL

# ==============================================================================
# Application Metadata & Runtime
# ==============================================================================
PROJECT_NAME="VerifAI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT=development    # Options: development, test, staging, production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Logging & Request Correlation
# ==============================================================================
LOG_LEVEL=INFO             # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
REQUEST_ID_HEADER="X-Request-ID"

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Allowed CORS Origins (comma-separated or JSON list of strings)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# ==============================================================================
# Database Configuration (PostgreSQL + asyncpg)
# ==============================================================================
# When unconfigured, readiness probe returns 503 and app runs in bootstrap mode.
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/verifai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=3.0

# ==============================================================================
# Future Integration Placeholders (Deferred to Subsequent Phases)
# ==============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key
