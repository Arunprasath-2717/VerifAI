# ==============================================================================
# VerifAI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="VerifAI API"
VERSION="0.1.0"
LOG_LEVEL=INFO

# Security & Authentication
# Generate a secure key in production: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=100
MAX_CONTENT_LENGTH=10485760

# Database Persistence (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://verifai:verifai_dev_secret@localhost:5432/verifai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=5.0

# CORS Configuration (JSON array of allowed origins; never wildcard in production)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Multi-LLM Provider Credentials (Leave blank if provider is unconfigured)
# If a model's key is not set, requests to that model will return truthful UNAVAILABLE status.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OLLAMA_BASE_URL=http://localhost:11434

# LLM Execution Limits
MAX_LLMS_PER_PROMPT=3
LLM_TIMEOUT_SECONDS=30.0

# Verification & Retrieval Configuration
VERIFAI_RETRIEVER_TYPE=web
TAVILY_API_KEY=
NIGHTCRAWLER_API_KEY=
