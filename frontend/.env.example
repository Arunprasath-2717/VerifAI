# Configure via Firebase console. These web identifiers are public, but must not
# be hardcoded to a particular production project in committed source.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional API override; defaults to same-origin /api/v1.
# VITE_API_BASE_URL=
